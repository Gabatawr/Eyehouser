{
  "name": "eyehouser",
  "private": true,
  "version": "0.1.57",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Gabatawr/Eyehouser#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabatawr/Eyehouser.git"
  },
  "bugs": {
    "url": "https://github.com/Gabatawr/Eyehouser/issues"
  },
  "keywords": [
    "chrome-extension",
    "mv3",
    "data-collector",
    "web-request",
    "competitive-analysis",
    "fetch-proxy",
    "xhr-proxy",
    "network-capture"
  ],
  "scripts": {
    "dev": "wxt",
    "build": "npm version --no-git-tag-version patch && npm run typecheck && wxt build",
    "zip": "npm version --no-git-tag-version patch && wxt zip",
    "lint": "wxt lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "log": "docker compose -f ../deploy/docker-compose.yml up -d log-server"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.2.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wxt": "^0.19.0"
  }
}
